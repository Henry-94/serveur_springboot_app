APP_NAME=communaute-backend
SERVER_PORT=8080
DB_URL=jdbc:postgresql://host:5432/database?prepareThreshold=0
DB_USERNAME=database-user
DB_PASSWORD=database-password
JWT_SECRET=generate-a-new-random-secret-at-least-32-characters
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000
APP_CORS_ALLOWED_ORIGINS=https://your-production-domain.example
